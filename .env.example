# Required: PostgreSQL/Neon connection string. Never commit the real value.
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Development/evaluation uses full_txns; production should use transactions.
MODEL_DATA_SOURCE=full_txns
MODEL_DIRECTORY=models

# Big-model operational probability thresholds.
BIG_MODEL_UNUSUAL_THRESHOLD=0.70
BIG_MODEL_SUSPICIOUS_THRESHOLD=0.90

# Small-model fraud-neighbourhood controls.
SMALL_MODEL_WINDOW_DAYS=60
SMALL_MODEL_UNUSUAL_RATE=0.05
SMALL_MODEL_SUSPICIOUS_RATE=0.10
SMALL_MODEL_SUSPICIOUS_LOWER_BOUND=0.08
SMALL_MODEL_MIN_CLUSTER_SIZE=100
SMALL_MODEL_MIN_FRAUD_COUNT=20
SMALL_MODEL_MAX_CLUSTERS=12
SMALL_MODEL_MIN_FRAUDS_PER_CLUSTER=5
DISTANCE_QUANTILE=0.95

# Rule-engine controls.
IMPOSSIBLE_TRAVEL_THRESHOLD_KMH=500.0
NEW_PAYEE_ALERT_THRESHOLD=10000.0
FRESH_ACCOUNT_TRANSACTION_THRESHOLD=5
FRESH_ACCOUNT_AGE_DAYS=15
RECURRING_TRANSACTION_MINIMUM=5
RECURRING_TRANSACTION_AGE_DAYS=7
RECURRING_TRANSACTION_AMOUNT_VARIANCE=5.0
RECURRING_TRANSACTION_TIME_VARIANCE_MINUTES=30

# Reproducibility.
RANDOM_SEED=42
